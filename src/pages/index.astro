---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Navbar from "../components/ui/Navbar.astro";
import { sections } from "../data/sections";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout>
  <Navbar />

  <main id="overview" transition:name="page-shell">
    <div class="overview-inner">
      <Hero />
      <nav class="panels-row" aria-label="Portfolio sections">
        {
          sections.map((section) => (
            <a
              href={`${basePath}/${section.slug}/`}
              class:list={["panel", section.panelClass]}
            >
              <span class="panel-label">{section.label}</span>
              <svg
                class="panel-arrow"
                aria-hidden="true"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          ))
        }
      </nav>
    </div>
  </main>
</Layout>

<style>
  #overview {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg0);
    transition: opacity 0.3s ease-in-out;
  }

  .overview-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
    padding: 0 1rem;
    max-width: 48rem;
  }

  .panels-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .panel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    position: relative;
    cursor: pointer;
  }

  .panel::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease-in-out;
  }

  .panel:hover::after,
  .panel:focus-visible::after {
    transform: scaleX(1);
  }

  .panel-label {
    font-size: 1.125rem;
    font-weight: 700;
    user-select: none;
  }

  .panel-arrow {
    flex-shrink: 0;
    transition: transform 0.3s ease-in-out;
  }

  .panel:hover .panel-arrow,
  .panel:focus-visible .panel-arrow {
    transform: rotate(90deg);
  }

  .panel-about-me {
    color: var(--color-blue-light);
  }

  .panel-projects {
    color: var(--color-purple-light);
  }

  .panel-contact {
    color: var(--color-green-light);
  }

  @media (min-width: 640px) {
    .panels-row {
      flex-direction: row;
      gap: 1.5rem;
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .overview-inner {
      gap: 3.5rem;
      padding: 0 1.5rem;
    }

    .panels-row {
      gap: 2.5rem;
    }

    .panel {
      padding: 1.5rem 2.5rem;
    }

    .panel-label {
      font-size: 1.5rem;
    }
  }
</style>
