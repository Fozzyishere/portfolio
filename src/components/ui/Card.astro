---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["card", className]}>
  <slot />
</div>

<style>
  .card {
    background-color: var(--color-bg1);
    max-width: 100%;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    padding: 1rem;
  }
</style>
