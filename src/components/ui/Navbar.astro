---
const navItems = [
  { id: "about-me", label: "About Me" },
  { id: "projects", label: "Projects" },
  { id: "contact", label: "Contact" },
];
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-10 transition-transform duration-300 translate-y-0"
>
  <div
    class="bg-bg0 text-fg1 flex flex-wrap items-center mx-auto p-4 drop-shadow-md"
  >
    <ul class="ml-auto flex flex-row">
      {
        navItems.map((item) => (
          <li class="mr-6 hover:text-blue-light transition-colors duration-200">
            <a href={`#${item.id}`} data-scroll-to={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const nav = document.getElementById("main-nav");
  let lastScrollY = 0;

  function handleScroll(): void {
    const currentScrollY = window.scrollY;

    // up
    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      nav?.classList.add("-translate-y-full");
      nav?.classList.remove("translate-y-0");
    }
    // down
    else {
      nav?.classList.remove("-translate-y-full");
      nav?.classList.add("translate-y-0");
    }

    lastScrollY = currentScrollY;
  }

  window.addEventListener("scroll", handleScroll, { passive: true });

  document.querySelectorAll("[data-scroll-to]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      const targetId = (e.currentTarget as HTMLElement).dataset.scrollTo;
      if (targetId) {
        const target = document.getElementById(targetId);
        target?.scrollIntoView({ behavior: "smooth" });
      }
    });
  });
</script>
