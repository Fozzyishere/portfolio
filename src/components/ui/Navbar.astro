---
const navItems = [
  { id: "about-me", label: "About Me" },
  { id: "projects", label: "Projects" },
  { id: "contact", label: "Contact" },
];
---

<nav id="main-nav" class="-translate-y-full">
  <div class="nav-inner">
    <button
      id="nav-back-btn"
      aria-label="Back to overview"
    >
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    </button>
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a href={`#${item.id}`} data-nav-section={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: transform 0.3s ease-in-out;
    will-change: transform;
  }

  .nav-inner {
    background-color: var(--color-bg0);
    color: var(--color-fg1);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 auto;
    padding: 1rem;
    filter: drop-shadow(0 3px 3px rgba(0, 0, 0, 0.12));
  }

  #nav-back-btn {
    color: var(--color-fg3);
    margin-right: 1rem;
    transition: color 0.2s ease-in-out;
  }

  #nav-back-btn:hover {
    color: var(--color-fg1);
  }

  ul {
    margin-left: auto;
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }

  li {
    transition: color 0.2s ease-in-out;
  }

  li:hover {
    color: var(--color-blue-light);
  }

  a {
    padding: 0.5rem 0;
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    ul {
      gap: 1.5rem;
    }
  }
</style>
