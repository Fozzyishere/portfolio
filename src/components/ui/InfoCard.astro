---
import { Image } from "astro:assets";
import Card from "./Card.astro";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  descText: string;
  techUsedText: string[];
  githubUrl?: string;
}

const { src, alt, descText, techUsedText, githubUrl } = Astro.props;
---

<div class="info-card-wrapper">
  <Card class="info-card">
    <div class="image-container">
      {
        githubUrl ? (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="image-link"
          >
            <Image src={src} alt={alt} priority class="project-image" />
          </a>
        ) : (
          <Image src={src} alt={alt} priority class="project-image" />
        )
      }
    </div>
    <div class="text-side">
      {
        githubUrl ? (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer">
            <h2 class="title title-link">{alt}</h2>
          </a>
        ) : (
          <h2 class="title">{alt}</h2>
        )
      }
      <p class="description">{descText}</p>
      <div class="tech-badges">
        {
          techUsedText.map((tech) => (
            <span class="badge">{tech}</span>
          ))
        }
      </div>
    </div>
  </Card>
</div>

<style>
  .info-card-wrapper {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .info-card-wrapper :global(.info-card) {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .image-container {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    border-radius: 2px;
    width: 100%;
  }

  .image-link {
    cursor: pointer;
    display: block;
  }

  .project-image {
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
  }

  .project-image:hover {
    transform: scale(0.95);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .text-side {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-purple-dark);
    margin-bottom: 0.5rem;
  }

  .title-link {
    cursor: pointer;
    transition: color 0.2s ease-in-out;
  }

  .title-link:hover {
    color: var(--color-purple-light);
  }

  .description {
    color: var(--color-fg1);
    font-size: 0.75rem;
  }

  .tech-badges {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .badge {
    padding: 0.25rem 0.5rem;
    background-color: var(--color-bg2);
    border-radius: 6px;
    font-size: 0.75rem;
  }

  @media (min-width: 640px) {
    .info-card-wrapper {
      margin-top: 2.5rem;
    }

    .info-card-wrapper :global(.info-card) {
      width: 83.333%;
    }

    .title {
      font-size: 1.25rem;
    }

    .description {
      font-size: 0.875rem;
    }
  }

  @media (min-width: 768px) {
    .info-card-wrapper :global(.info-card) {
      flex-direction: row;
      width: 100%;
    }

    .image-container {
      flex: 0 0 40%;
    }

    .text-side {
      flex: 1 1 0%;
      width: auto;
      margin-left: 1rem;
    }
  }
</style>
