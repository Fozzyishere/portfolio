---
import Card from "./Card.astro";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  descText: string;
  techUsedText: string[];
  githubUrl?: string;
}

const { src, alt, descText, techUsedText, githubUrl } = Astro.props;
---

<div class="mt-6 sm:mt-10 flex justify-center items-center w-full">
  <Card class="flex flex-col md:flex-row w-full sm:w-5/6 md:w-full">
    <div
      class="relative overflow-hidden content-center rounded-sm w-full md:w-2/3"
    >
      {
        githubUrl ? (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer block"
          >
            <img
              src={src.src}
              alt={alt}
              width={500}
              height={500}
              loading="lazy"
              class="hover:scale-95 hover:shadow-2xl transition-all duration-300"
            />
          </a>
        ) : (
          <img
            src={src.src}
            alt={alt}
            width={500}
            height={500}
            loading="lazy"
          />
        )
      }
    </div>
    <div class="p-4 md:ml-4 flex flex-col w-full md:w-2/3">
      {
        githubUrl ? (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer">
            <h2 class="text-lg sm:text-xl font-semibold text-purple-dark mb-2 hover:text-purple-light transition-colors duration-200 cursor-pointer">
              {alt}
            </h2>
          </a>
        ) : (
          <h2 class="text-lg sm:text-xl font-semibold text-purple-dark mb-2">
            {alt}
          </h2>
        )
      }
      <p class="text-fg1 text-xs sm:text-sm">{descText}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          techUsedText.map((tech) => (
            <span class="px-2 py-1 bg-bg2 rounded-md text-xs">{tech}</span>
          ))
        }
      </div>
    </div>
  </Card>
</div>
