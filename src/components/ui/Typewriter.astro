---
interface Props {
  text: string;
  typeSpeed?: number;
  class?: string;
}

const { text, typeSpeed = 60, class: className } = Astro.props;
---

<span
  class:list={["typewriter", className]}
  data-text={text}
  data-speed={typeSpeed}></span>

<script>
  class Typewriter {
    private element: HTMLElement;
    private text: string;
    private speed: number;
    private index: number = 0;

    constructor(element: HTMLElement) {
      this.element = element;
      this.text = element.dataset.text || "";
      this.speed = parseInt(element.dataset.speed || "60", 10);
      this.start();
    }

    private start(): void {
      this.type();
    }

    private type(): void {
      if (this.index < this.text.length) {
        this.element.textContent += this.text.charAt(this.index);
        this.index++;
        setTimeout(() => this.type(), this.speed);
      }
    }
  }

  // Use Intersection Observer to start typing only when visible
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          new Typewriter(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll(".typewriter").forEach((el) => {
    observer.observe(el);
  });
</script>
