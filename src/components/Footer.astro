---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <p>
      &copy; {currentYear} Quoc Huy Pham. All rights reserved (when needed :3 ).
    </p>
  </div>
</footer>

<style>
  footer {
    width: 100%;
    text-align: center;
    padding: 2rem 0;
    margin-top: auto;
    border-top: 1px solid var(--color-bg1);
  }

  .footer-inner {
    max-width: 80rem;
    margin: 0 auto;
  }

  p {
    color: var(--color-fg3);
    font-size: 0.875rem;
  }
</style>
