---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import {
  colorProperties,
  colorThemes,
  COLOR_THEME_STORAGE_KEY,
} from "../scripts/color-theme";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Quoc's Portfolio",
  description = "Quoc Huy Pham - Software Engineer Portfolio",
} = Astro.props;
const faviconUrl = new URL('/favicon.svg', import.meta.env.SITE + import.meta.env.BASE_URL).pathname;
const basePath = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-base-path={basePath}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description}
    />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Geist+Mono&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />

    <script
      is:inline
      define:vars={{ colorThemes, colorProperties, storageKey: COLOR_THEME_STORAGE_KEY }}
    >
      (function () {
        var stored = sessionStorage.getItem(storageKey);
        var theme =
          stored && colorThemes.indexOf(stored) !== -1
            ? stored
            : colorThemes[Math.floor(Math.random() * colorThemes.length)];

        if (!stored || colorThemes.indexOf(stored) === -1) {
          sessionStorage.setItem(storageKey, theme);
        }

        var root = document.documentElement;

        colorProperties.forEach(function (prop) {
          root.style.setProperty(
            "--color-" + prop,
            "var(--color-" + theme + "-" + prop + ")"
          );
        });
      })();
    </script>
    <script>
      import "../scripts/route-transitions";
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
