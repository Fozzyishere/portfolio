---
import Layout from "./Layout.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/ui/Navbar.astro";
import type { PortfolioSection } from "../data/sections";

interface Props {
  section: PortfolioSection;
  description?: string;
}

const {
  section,
  description = `${section.label} - Quoc Huy Pham Portfolio`,
} = Astro.props;
const portfolioHomeHref = import.meta.env.BASE_URL;
---

<Layout title={`${section.label} | Quoc's Portfolio`} description={description}>
  <Navbar visible currentSlug={section.slug} />

  <main id="detail" class="detail-shell" transition:name="page-shell">
    <div class="detail-inner">
      <a
        class="back-heading"
        href={portfolioHomeHref}
        transition:name="section-heading"
        data-astro-prefetch="hover"
      >
        <h1 style={`--heading-color: ${section.color};`}>
          {section.label}
        </h1>
        <svg class="back-arrow" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <div id="section-content" transition:name="section-content">
        <slot />
      </div>

      <Footer />
    </div>
  </main>
</Layout>

<style>
  .detail-shell {
    background-color: var(--color-bg0);
    min-height: 100dvh;
  }

  .detail-inner {
    padding: 5rem 1rem 1.5rem;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .back-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fg3);
    padding: 2rem 0;
    transition: color 0.2s ease-in-out;
    align-self: center;
  }

  .back-heading:hover {
    color: var(--color-fg1);
  }

  h1 {
    font-size: 1.25rem;
    color: var(--heading-color);
    font-weight: 700;
  }

  .back-arrow {
    transition: transform 0.3s ease-in-out;
  }

  .back-heading:hover .back-arrow {
    transform: rotate(-90deg);
  }

  #section-content {
    flex: 1;
  }

  @media (min-width: 640px) {
    .detail-inner {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      padding-bottom: 2rem;
    }
  }

  @media (min-width: 768px) {
    .detail-inner {
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 2.5rem;
    }

    h1 {
      font-size: 1.875rem;
    }

    #section-content {
      padding: 2.5rem 0;
    }
  }

  @media (min-width: 1024px) {
    .detail-inner {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
      padding-bottom: 3rem;
    }
  }
</style>
